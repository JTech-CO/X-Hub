{
  "manifest_version": 3,
  "name": "X Hub",
  "version": "3.3.1",
  "minimum_chrome_version": "111",
  "description": "All-in-one X toolkit: run raffles, manage follows, filter posts, and view multiple X timelines side by side.",
  "icons": {
    "16": "icons/XH16.png",
    "48": "icons/XH48.png",
    "128": "icons/XH128.png"
  },
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.x.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "vertical.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["fetch-interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "X Hub"
  }
}
